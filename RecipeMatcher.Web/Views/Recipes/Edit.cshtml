@model EditRecipeViewModel

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly"></div>

    <input asp-for="Id" type="hidden" />

    <label asp-for="Name"></label>
    <input asp-for="Name" />
    <span asp-validation-for="Name"></span>

    <label asp-for="PreparationMinutes"></label>
    <input asp-for="PreparationMinutes" />
    <span asp-validation-for="PreparationMinutes"></span>

    <h3>Ingredients</h3>
    @for (var i = 0; i < Model.Ingredients.Count; i++)
    {
        <label>
            <input type="checkbox" name="ingredientIds" value="@Model.Ingredients[i].Id"
                   checked="@Model.Ingredients[i].Selected" />
            @Model.Ingredients[i].Name
        </label>
    }

    <button type="submit">Edit</button>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}